{
  "expo": {
    "name": "Tia",
    "slug": "tia-secretary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lv.rderics.tia"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "lv.rderics.tia",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0C0B0F",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Tia listens only while you hold the talk button. Recordings are deleted right after they are turned into text."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used only to scan the pairing QR code on Tia's screen.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "049784b8-5816-4c1e-a1ea-63b463aa685e"
      }
    },
    "owner": "rderics"
  }
}

{
  "name": "tia",
  "version": "0.1.0",
  "description": "Tia - AI personal secretary (RobotHack 2026 prototype)",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "build:scene": "esbuild src/scene/scene.js --bundle --format=iife --global-name=TiaScene --minify --outfile=src/renderer/scene.js",
    "web": "node src/web.js",
    "start": "electron .",
    "replay": "electron . --replay",
    "day": "node scripts/run-day.js",
    "screenshot": "electron . --replay --screenshot=data/screenshot.png",
    "build:avatar": "esbuild src/scene/vrm-avatar.js --bundle --format=iife --global-name=TiaAvatar --minify --alias:three=three186 --outfile=src/renderer/avatar.js",
    "build:graph": "esbuild src/scene/graph-entry.js --bundle --format=iife --minify --outfile=src/renderer/channels/graph.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "^3.6.0",
    "electron": "45.4.1",
    "esbuild": "0.24.0",
    "force-graph": "^1.52.0",
    "three": "0.170.0",
    "three186": "npm:three@^0.186.0"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "esbuild@0.24.0": true
  }
}
